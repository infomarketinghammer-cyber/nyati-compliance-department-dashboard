# GEMINI_API_KEY: Gemini API key for the AI Legal Intelligence Advisor (server-side only).
# Without it the advisor answers from the built-in offline analysis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Key used to sign login sessions. Must be the same on every server instance.
# If unset, a key is derived from GEMINI_API_KEY. Generate one with: openssl rand -hex 32
SESSION_SECRET="MY_SESSION_SECRET"
